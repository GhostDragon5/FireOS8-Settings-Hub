<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FireOS8SettingsHub" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Animation.TransparentSlide" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_from_bottom</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_to_bottom</item>
    </style>

    <style name="Widget.FireOS8SettingsHub.Button" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/tv_button_background</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingHorizontal">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@drawable/tv_button_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.FireOS8SettingsHub.CloseButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">108dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/close_button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@drawable/tv_button_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.FireOS8SettingsHub.ThemeChoice" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.FireOS8SettingsHub.DialogThemeChoice" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
